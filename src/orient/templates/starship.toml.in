# Docs: https://starship.rs/config/#style-strings
# Merge these module tables into your existing starship.toml.
[directory]
style = "bold fg:#{{primary}}"
[character]
success_symbol = "[❯](bold fg:#{{green}})"
error_symbol = "[❯](bold fg:#{{error}})"
[git_branch]
style = "bold fg:#{{secondary}}"
[git_status]
style = "fg:#{{tertiary}}"
[cmd_duration]
style = "fg:#{{onSurfaceVariant}}"
