# Docs: https://github.com/tmux/tmux/blob/master/tmux.1
# Source explicitly from your tmux.conf; changes apply to that server only.
set -g status-style "fg=#{{onSurface}},bg=#{{surface}}"
set -g message-style "fg=#{{onPrimaryContainer}},bg=#{{primaryContainer}}"
set -g message-command-style "fg=#{{onSecondaryContainer}},bg=#{{secondaryContainer}}"
set -g pane-border-style "fg=#{{outlineVariant}}"
set -g pane-active-border-style "fg=#{{primary}}"
set -g mode-style "fg=#{{onPrimaryContainer}},bg=#{{primaryContainer}}"
set -g window-status-style "fg=#{{onSurfaceVariant}},bg=#{{surface}}"
set -g window-status-current-style "fg=#{{onPrimaryContainer}},bg=#{{primaryContainer}}"
set -g window-status-bell-style "fg=#{{onErrorContainer}},bg=#{{errorContainer}}"
