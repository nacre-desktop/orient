# Docs: https://pwmt.org/projects/zathura/documentation/
# Include from zathurarc. Document recoloring is opt-in: set recolor true.
set default-bg "#{{surface}}"
set default-fg "#{{onSurface}}"
set statusbar-bg "#{{surfaceContainer}}"
set statusbar-fg "#{{onSurface}}"
set inputbar-bg "#{{surfaceContainer}}"
set inputbar-fg "#{{onSurface}}"
set completion-bg "#{{surfaceContainer}}"
set completion-fg "#{{onSurface}}"
set completion-highlight-bg "#{{primaryContainer}}"
set completion-highlight-fg "#{{onPrimaryContainer}}"
set notification-bg "#{{surfaceContainer}}"
set notification-fg "#{{onSurface}}"
set notification-error-bg "#{{errorContainer}}"
set notification-error-fg "#{{onErrorContainer}}"
set highlight-color "#{{primaryContainer}}"
set highlight-active-color "#{{secondaryContainer}}"
set recolor-darkcolor "#{{onSurface}}"
set recolor-lightcolor "#{{surface}}"
