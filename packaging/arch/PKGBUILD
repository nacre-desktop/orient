# Maintainer: siverteh <92440237+Siverteh@users.noreply.github.com>
pkgbase=orient
pkgname=('orient')
pkgver=0.1.0dev7
_pyver=0.1.0.dev7
pkgrel=1
pkgdesc='Wallpaper colors, readable palettes and portable theme templates'
arch=('x86_64' 'aarch64')
url='https://github.com/nacre-desktop/orient'
license=('MIT')
# GCC LTO archives cannot be consumed by Rust's LLVM linker. Cargo retains its
# own release optimization; only makepkg's cross-language LTO flags are disabled.
options=('!lto')
# The Python package and its Pillow-parity suites ship through PyPI and Orient's CI;
# the Arch release carries only the native engine, checked against its frozen goldens.
makedepends=('python-build' 'python-installer' 'rust' 'python-maturin' 'lcms2' 'git' 'cmake')
checkdepends=('ffmpeg' 'python' 'python-pillow')
optdepends=('ffmpeg: video frame sampling')
_revision=d2cf2dad5bd9590121676cc5332052c523795718
_srcdir=orient
source=("orient::git+${url}.git#commit=${_revision}")
sha256sums=('SKIP')

build() {
  cd "$_srcdir"
  cargo build --release --locked -p orient-cli --bins --example normalized_frames
  python -m build --wheel --no-isolation
}

check() {
  cd "$_srcdir"
  # The wheel is installed only to drive the native golden comparison.
  python -m venv --system-site-packages "${srcdir}/smoke-venv"
  "${srcdir}/smoke-venv/bin/python" -m installer dist/*.whl
  cargo test --locked --quiet
  target/release/orient --version
  "${srcdir}/smoke-venv/bin/python" tests/parity/check_native_golden.py -q
}

package_orient() {
  pkgdesc='Standalone wallpaper color engine and theme templates'
  depends=('lcms2' 'glibc' 'gcc-libs')
  license=('MIT' 'MIT-CMU' 'BSD-3-Clause' 'IJG' 'Zlib')
  optdepends=('ffmpeg: video frame sampling')
  cd "$_srcdir"
  install -Dm644 crates/orient-decoder/LICENSE-Pillow "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Pillow"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 third-party/libjpeg-turbo-LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/libjpeg-turbo-LICENSE.md"
  install -Dm755 target/release/orient "$pkgdir/usr/bin/orient"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
